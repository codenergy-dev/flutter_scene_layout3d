// The panel every Material component in a flutter_scene_layout3d tree is made
// of: one slab, one material, a rounded-box signed distance field, and no
// geometry work at any size.
//
// The fragment shader never learns where it is in the box from the engine —
// a .fmat surface is handed a world position, a normal and a UV, none of
// which say "two thirds of the way across this card". BoxDecoration3dPainter
// solves that by shipping a unit slab whose vertex colours are its own
// object-space coordinates, biased into [0, 1]. Recovering the position is
// therefore exact, and costs one subtract and one multiply.
//
// Every length below is in world units. The Dart side
// (BoxDecoration3dUniforms) converts from the logical pixels a component spec
// is written in, clamps the radii to what the box can fit and folds the state
// layer's opacity into its alpha, so nothing here has to know about metrics.
//
// That same trick is what makes the press ripple two parameters rather than a
// redesign: a fragment that knows where in the box it is can measure its own
// distance from where the finger landed, and the ripple is one smoothstep on
// that distance.

material {
  name: "BoxDecoration3d",
  shading_model: lit,
  blending: alpha,
  // **`depth_write` stays on, and a fragment with nothing in it discards.**
  //
  // A blended draw that writes depth occludes whatever is drawn after it,
  // whatever its own alpha — so a fully transparent panel used to punch a
  // hole clean through the surface behind it. That is not a corner case: a
  // navigation destination, a text button, an outlined button's interior are
  // each a `Material3d` with no colour in it, standing on another one.
  //
  // The obvious answer is to turn `depth_write` off, which is what the engine
  // defaults to for an alpha-blended material, and it is **wrong here**. It
  // leaves the whole catalogue to the translucent pass's back-to-front sort,
  // and that sort is one number per draw: the world-space centre of the
  // geometry's bounds along the camera's forward. A Material screen is full
  // of slabs that share a centre — a `Material3d` hands its child a tight
  // depth, so a destination's surface and the bar it lives in come out
  // co-centred — and a tie in that sort is not an ordering at all.
  // Photographed both ways: turning `depth_write` off traded the hole in the
  // navigation bar for a selection indicator that was simply not there any
  // more.
  //
  // So the depth buffer keeps ordering these panels, and the fragment shader
  // takes responsibility for not writing depth where it draws nothing. See
  // the `base.a` discard at the end of `Surface`.
  //
  // What this does **not** fix is a *partly* transparent slab — a 5% wash, a
  // 32% scrim — standing in front of something the sort puts after it.
  //
  // This note used to prescribe the fix: depth write chosen per instance,
  // with the rule "a decoration whose resolved colour is not opaque does not
  // write depth", the sort being the only thing ordering it. **That was
  // photographed and it does not work.** With depth write off, a modal's
  // scrim stopped erasing the app bar behind it and started being drawn
  // *under* it — the error inverts rather than closing, because the sort was
  // wrong about that pair either way. Writing depth is not the problem on its
  // own.
  //
  // The catalogue's answer is to stop being partly transparent: a scrim draws
  // in an opaque colour and keeps a fraction of its fragments, so every
  // fragment it does draw is an opaque one and the order stops mattering. See
  // `flutter_scene_material3d`'s `scrimCoverage3d`, and
  // `plans/2026_09_17_a_scrim_that_dims_evenly.md` for the four pictures.
  depth_write: true,
  culling: back,

  parameters: [
    // Half the box's extent, in layout axes: x across, y down, z away.
    { type: vec3, name: half_extent, default: [0.5, 0.5, 0.05] },
    // Corner radii, clockwise from the origin corner: top-left, top-right,
    // bottom-right, bottom-left.
    { type: vec4, name: corner_radius, default: [0, 0, 0, 0] },
    // How far the slab's rim is rounded along the depth axis.
    { type: float, name: bevel, default: 0.0 },
    // The border's thickness, drawn inside the outline. Zero for none.
    { type: float, name: border_width, default: 0.0 },

    { type: vec4, name: color, hint: source_color, default: [1, 1, 1, 1] },
    { type: vec4, name: border_color, hint: source_color, default: [0, 0, 0, 1] },
    // Hover / focus / press / drag, opacity already folded into alpha.
    { type: vec4, name: state_layer, hint: source_color, default: [0, 0, 0, 0] },
    // Where a press landed, in the box's own frame — origin at the box's
    // corner, the same frame the clip planes are measured in — and only the
    // two in-plane axes, because a ripple is a circle on the face rather
    // than a sphere in the slab.
    { type: vec2, name: ripple_origin, default: [0, 0] },
    // The press ripple: x its radius, y its alpha. The *colour* is
    // state_layer.rgb, because Material 3's ripple is the press state layer
    // with an origin rather than a second wash — which is why this is two
    // floats and not a fifth vec4.
    { type: vec2, name: ripple, default: [0, 0] },
    // Material 3's elevation tint, its amount already folded into alpha.
    { type: vec4, name: surface_tint, hint: source_color, default: [0, 0, 0, 0] },

    // The gradient that fills the panel in place of `color`: x its kind (0 for
    // none, 1 linear, 2 radial, 3 sweep), y its tile mode (0 clamp, 1
    // repeated, 2 mirror, 3 decal), z how many stops are in use.
    { type: vec4, name: gradient, default: [0, 0, 0, 0] },
    // The gradient's geometry, in the box's own frame (origin at the corner).
    // Linear: the start point in xy and the end point in zw. Radial: the
    // centre in xy and the radius in z. Sweep: the centre in xy and the start
    // and end angles, in radians, in z and w.
    { type: vec4, name: gradient_geometry, default: [0, 0, 0, 0] },
    // Up to eight stops, four to a vector, ascending.
    { type: vec4, name: gradient_stops_0, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_stops_1, default: [0, 0, 0, 0] },
    // The colours at those stops, **in sRGB and not decoded**, which is why
    // none of them is tagged `source_color`. A gradient interpolates between
    // its stops in sRGB, as Skia does, so the decode to linear has to happen
    // after the interpolation rather than before it.
    { type: vec4, name: gradient_color_0, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_1, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_2, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_3, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_4, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_5, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_6, default: [0, 0, 0, 0] },
    { type: vec4, name: gradient_color_7, default: [0, 0, 0, 0] },

    // Where the picture is drawn, in the box's own frame: x and y its corner,
    // z and w its extent. It may be larger than the box — a picture that
    // covers the panel — and the outline cuts it, exactly as a Flutter
    // decoration's image is clipped to its rounded rectangle.
    { type: vec4, name: image_rect, default: [0, 0, 1, 1] },
    // Which part of the picture lands in `image_rect`, as texture coordinates:
    // the left and top in xy, the right and bottom in zw. A right edge less
    // than the left is a picture mirrored for a right-to-left reading.
    { type: vec4, name: image_source, default: [0, 0, 1, 1] },
    // How much of the picture to draw. Zero is no picture, and is what every
    // panel without one is given.
    { type: float, name: image_opacity, default: 0.0 },

    // **How much of this box survives, from 0 to 1** — the opacity in force,
    // from `Layout3d.inheritedOpacity`, written by
    // `BoxDecoration3dUniforms.applyTo`.
    //
    // It is **coverage, not alpha**, and that is the whole design of fading
    // in this package. Folding an opacity into the alpha would mean folding
    // it into every colour below — `color`, `border_color`, `state_layer`,
    // `surface_tint`, the eight gradient stops and `image_opacity` — and,
    // worse, it would make a faded panel a *partly* transparent slab that
    // writes depth, which is the case the `depth_write` note above leaves
    // open: it hides what is behind it instead of showing it through.
    // Turning depth write off instead is worse again, and fails at opacity
    // 1.0, where nothing is supposed to be happening. Both were photographed
    // failing; see `plans/2026_09_16_a_box_that_fades.md`.
    //
    // So a fragment either draws in full or is thrown away, and the ones
    // that survive blend and order themselves exactly as an unfaded panel's
    // do. See `ScreenDoor` in the fragment block for which ones survive.
    { type: float, name: fade, default: 1.0 },
    { type: float, name: metallic, hint: range(0, 1, 0.01), default: 0.0 },
    { type: float, name: roughness, hint: range(0, 1, 0.01), default: 0.5 },

    // The clip in force, in the box's own frame (origin at the box's corner).
    // xyz is a normal, w a distance; a fragment survives where
    // dot(n, p) + w >= 0 for every plane. An unused slot is (0, 0, 0, 1),
    // which keeps everything. Six is Clip3dRegion.maxPlanes, which is exactly
    // one axis-aligned box, which is what intersecting layout clips folds to.
    { type: vec4, name: clip_plane_0, default: [0, 0, 0, 1] },
    { type: vec4, name: clip_plane_1, default: [0, 0, 0, 1] },
    { type: vec4, name: clip_plane_2, default: [0, 0, 0, 1] },
    { type: vec4, name: clip_plane_3, default: [0, 0, 0, 1] },
    { type: vec4, name: clip_plane_4, default: [0, 0, 0, 1] },
    { type: vec4, name: clip_plane_5, default: [0, 0, 0, 1] },

    // The picture. Straight alpha, sRGB, decoded in `Surface`. Bound per box
    // by the painter once the pixels have arrived; until then `image_opacity`
    // is zero and the placeholder is never seen.
    { type: sampler2d, name: image_texture, hint: default_white },
  ],
}

fragment {
  // Throws this fragment away unless it is one of the `fade`-th of them that
  // a subtree at that opacity keeps: **screen-door coverage**.
  //
  // The canonical copy of this block. `text_glyph3d.fmat` and
  // `text_glyph_wall3d.fmat` carry the same four lines, because the three
  // primitives a faded label is made of — the glyph faces, their back faces
  // and the wall around them — have to agree at every pixel or a letter
  // tears along its own rim. They agree for free: the threshold is a
  // function of `gl_FragCoord` alone, so at a given pixel all three make the
  // same keep-or-discard decision.
  //
  // **The matrix is an ordered 4x4 Bayer one, not a hash.** The engine's own
  // `shaders/lod_fade.glsl` thresholds against a Weyl hash, which is tuned
  // for what it fades: foliage, far away, small on screen and resolved by
  // temporal anti-aliasing. A panel is the opposite case — hundreds of
  // pixels across, still, with no TAA in this stack — and the hash has
  // enough low-frequency structure at that scale to photograph as diagonal
  // hatching. The ordered matrix photographed as nothing at all. Both were
  // built and compared; the pictures are in
  // `plans/2026_09_16_a_box_that_fades.md`.
  //
  // `+ 0.5` puts the sixteen thresholds at the centres of their cells, so
  // the lowest is 1/32 rather than 0 and **a fade of exactly 0 keeps
  // nothing**. At the other end the guard above it means a fade of exactly
  // 1.0 does not execute at all, which is the property every probe on this
  // checks: a faded box at full opacity must draw what an unfaded one draws.
  void ScreenDoor(float fade) {
    if (fade >= 1.0) {
      return;
    }
    const float kBayer4x4[16] = float[16](
         0.0,  8.0,  2.0, 10.0,
        12.0,  4.0, 14.0,  6.0,
         3.0, 11.0,  1.0,  9.0,
        15.0,  7.0, 13.0,  5.0);
    ivec2 cell = ivec2(mod(gl_FragCoord.xy, 4.0));
    if ((kBayer4x4[cell.y * 4 + cell.x] + 0.5) / 16.0 >= fade) {
      discard;
    }
  }

  // The radius in force at p, picked from the four corners by which quadrant
  // of the face p is in. Written the way every rounded-box SDF is written, so
  // it reads the same as its source.
  float RadiusAt(vec2 p, vec4 radii) {
    float top = p.x > 0.0 ? radii.y : radii.x;
    float bottom = p.x > 0.0 ? radii.z : radii.w;
    return p.y > 0.0 ? bottom : top;
  }

  // Signed distance to a rounded box of half-extent b, negative inside.
  float RoundedBox(vec2 p, vec2 b, float r) {
    vec2 q = abs(p) - b + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
  }

  float GradientStop(int i) {
    return i < 4
        ? material_params.gradient_stops_0[i]
        : material_params.gradient_stops_1[i - 4];
  }

  vec4 GradientColor(int i) {
    if (i == 0) return material_params.gradient_color_0;
    if (i == 1) return material_params.gradient_color_1;
    if (i == 2) return material_params.gradient_color_2;
    if (i == 3) return material_params.gradient_color_3;
    if (i == 4) return material_params.gradient_color_4;
    if (i == 5) return material_params.gradient_color_5;
    if (i == 6) return material_params.gradient_color_6;
    return material_params.gradient_color_7;
  }

  // The colour at t along the gradient's stops, still in sRGB and straight
  // alpha. Below the first stop is the first colour and past the last is the
  // last, which is also what makes two stops at one position a hard edge.
  vec4 GradientAt(float t) {
    int count = int(material_params.gradient.z + 0.5);
    if (t <= GradientStop(0)) {
      return GradientColor(0);
    }
    for (int i = 1; i < 8; i++) {
      if (i >= count) {
        break;
      }
      float to = GradientStop(i);
      if (t <= to) {
        float from = GradientStop(i - 1);
        float span = to - from;
        float f = span > 0.0 ? (t - from) / span : 1.0;
        return mix(GradientColor(i - 1), GradientColor(i), f);
      }
    }
    return GradientColor(max(count - 1, 0));
  }

  // Where along the gradient a point in the box's corner frame is, before
  // the tile mode has had its say. Skia's arithmetic, one kind at a time.
  float GradientT(vec2 p) {
    float kind = material_params.gradient.x;
    vec4 g = material_params.gradient_geometry;
    if (kind < 1.5) {
      vec2 axis = g.zw - g.xy;
      float length2 = dot(axis, axis);
      return length2 > 0.0 ? dot(p - g.xy, axis) / length2 : 0.0;
    }
    if (kind < 2.5) {
      return g.z > 0.0 ? length(p - g.xy) / g.z : 0.0;
    }
    // y runs down in this frame, as it does on a Flutter canvas, so an angle
    // measured from +x toward +y sweeps clockwise on the face exactly as a
    // `SweepGradient` does on a screen.
    vec2 d = p - g.xy;
    float angle = atan(d.y, d.x);
    if (angle < 0.0) {
      angle += 6.283185307179586;
    }
    float span = g.w - g.z;
    return span != 0.0 ? (angle - g.z) / span : 0.0;
  }

  void Surface(inout MaterialInputs material) {
    // Before anything else: a fragment this box's opacity throws away costs
    // nothing further, and must not write depth.
    ScreenDoor(material_params.fade);

    // The object-space position, recovered from the vertex colour the painter
    // baked in. Centre of the box is the origin.
    vec3 p = (GetVertexColor().rgb - 0.5) * 2.0 * material_params.half_extent;

    // The clip runs in the box's own frame, whose origin is the corner.
    vec3 clip_p = p + material_params.half_extent;
    float keep = 1.0;
    keep = min(keep, dot(material_params.clip_plane_0.xyz, clip_p) + material_params.clip_plane_0.w);
    keep = min(keep, dot(material_params.clip_plane_1.xyz, clip_p) + material_params.clip_plane_1.w);
    keep = min(keep, dot(material_params.clip_plane_2.xyz, clip_p) + material_params.clip_plane_2.w);
    keep = min(keep, dot(material_params.clip_plane_3.xyz, clip_p) + material_params.clip_plane_3.w);
    keep = min(keep, dot(material_params.clip_plane_4.xyz, clip_p) + material_params.clip_plane_4.w);
    keep = min(keep, dot(material_params.clip_plane_5.xyz, clip_p) + material_params.clip_plane_5.w);
    if (keep < 0.0) {
      discard;
    }

    vec2 face = p.xy;
    vec2 half_face = material_params.half_extent.xy;
    float radius = RadiusAt(face, material_params.corner_radius);

    // The bevel eats into the face radius as the fragment approaches the
    // slab's rim, which is what rounds the thickness without a second SDF.
    float rim = material_params.half_extent.z - abs(p.z);
    float bevel = material_params.bevel;
    float inset = bevel > 0.0
        ? bevel - sqrt(max(bevel * bevel - max(bevel - rim, 0.0) * max(bevel - rim, 0.0), 0.0))
        : 0.0;

    float d = RoundedBox(face, half_face - vec2(inset), max(radius - inset, 0.0));

    // One pixel of coverage either side of the outline, from the screen-space
    // rate of change of the distance. This is what makes the corners
    // resolution-independent: they are as sharp as the display is, at any
    // size, with no geometry.
    float aa = max(fwidth(d), 1e-6);
    float coverage = 1.0 - smoothstep(-aa, aa, d);
    if (coverage <= 0.0) {
      discard;
    }

    // The border is the outer band of the same distance field: the fragments
    // whose distance to the outline is shallower than the border's width.
    //
    // `d` is negative inside, so "within `border` of the edge" is
    // `d > -border`, which is what this smoothstep says, feathered by one
    // pixel either side of `-border` exactly as the outline is. There is
    // deliberately no `1.0 -` here: an earlier version had one, which painted
    // the border colour over the entire interior and left the fill as a thin
    // rim around it — the exact inverse of a border. Nothing caught it until
    // a render probe looked at a bordered panel, because every headless test
    // of this shader is about its parameters and not its picture.
    float border = material_params.border_width;
    float border_mix = border > 0.0
        ? smoothstep(-border - aa, -border + aa, d)
        : 0.0;

    // What fills the panel, in Flutter's painting order: the colour, or the
    // gradient in its place, and then the picture over whichever it was. The
    // border, the tint, the state layer and the ripple all go on top, so a
    // photograph on a card is washed by a hover exactly as its colour is.
    vec4 fill = material_params.color;
    if (material_params.gradient.x > 0.5) {
      float t = GradientT(clip_p.xy);
      float tile = material_params.gradient.y;
      float visible = 1.0;
      if (tile < 0.5) {
        t = clamp(t, 0.0, 1.0);
      } else if (tile < 1.5) {
        t = fract(t);
      } else if (tile < 2.5) {
        float m = mod(t, 2.0);
        t = m > 1.0 ? 2.0 - m : m;
      } else {
        visible = t < 0.0 || t > 1.0 ? 0.0 : 1.0;
      }
      vec4 ramp = GradientAt(t);
      fill = vec4(SRGBToLinear(ramp.rgb), ramp.a * visible);
    }

    // The picture is sampled whatever its opacity, before any branch, so the
    // texture's derivatives — which pick its mip level — are taken from
    // neighbouring fragments that all ran the same code.
    vec4 rect = material_params.image_rect;
    vec2 local = (clip_p.xy - rect.xy) / max(rect.zw, vec2(1e-9));
    vec4 source = material_params.image_source;
    vec4 texel = texture(image_texture, mix(source.xy, source.zw, local));
    float image_opacity = material_params.image_opacity;
    if (image_opacity > 0.0) {
      // Inside the destination rectangle, feathered by a pixel *outward*: the
      // sampler clamps to the picture's edge, so the pixel beyond it repeats
      // the edge rather than showing the fill, and a picture that covers the
      // panel exactly has no seam of fill colour round its rim.
      vec2 inset = min(local, 1.0 - local) * rect.zw;
      float edge = min(inset.x, inset.y);
      float eaa = max(fwidth(edge), 1e-6);
      float inside = smoothstep(-eaa, 0.0, edge);
      float a = texel.a * image_opacity * inside;
      float over = a + fill.a * (1.0 - a);
      vec3 picture = SRGBToLinear(texel.rgb);
      fill.rgb = over > 0.0
          ? (picture * a + fill.rgb * fill.a * (1.0 - a)) / over
          : fill.rgb;
      fill.a = over;
    }

    vec4 base = mix(fill, material_params.border_color, border_mix);
    base.rgb = mix(base.rgb, material_params.surface_tint.rgb, material_params.surface_tint.a);
    base.rgb = mix(base.rgb, material_params.state_layer.rgb, material_params.state_layer.a);

    // The press ripple, on top of the uniform wash: the same colour, bounded
    // by a circle around where the finger landed. The origin arrives in the
    // corner frame, so it is moved to the centre frame `face` is in by
    // subtracting the half extent — the same change of frame `clip_p` makes,
    // in reverse.
    //
    // `smoothstep` here is not decoration: without it the circle's rim is a
    // staircase at any size, and feathering it by one pixel of the *radial*
    // distance's own screen-space rate of change makes it as sharp as the
    // display is, exactly as the outline above is.
    float ripple_alpha = material_params.ripple.y;
    if (ripple_alpha > 0.0) {
      vec2 from_origin = face - (material_params.ripple_origin - half_face);
      float rd = length(from_origin) - material_params.ripple.x;
      float raa = max(fwidth(rd), 1e-6);
      float lit = 1.0 - smoothstep(-raa, raa, rd);
      base.rgb = mix(base.rgb, material_params.state_layer.rgb, ripple_alpha * lit);
    }

    base.a *= coverage;

    // **Nothing to draw is not the same as drawing nothing.** A fragment
    // with no alpha contributes no colour either way, but it still writes
    // depth, and a panel that writes depth occludes everything drawn behind
    // it afterwards. A fully transparent `Material3d` — an unselected
    // navigation destination, a text button, the interior of an outlined
    // one — therefore erased the surface it was standing on and left the
    // scene's backdrop showing through its own outline.
    //
    // A state layer cannot rescue such a fragment either: the wash mixes
    // into `base.rgb` and leaves `base.a` alone, so a hover on a colourless
    // surface has nothing to be seen against and this discards exactly the
    // fragments that were never going to be visible.
    if (base.a <= 0.0) {
      discard;
    }

    material.base_color = base;
    material.metallic = material_params.metallic;
    material.roughness = material_params.roughness;
    material.normal = GetWorldNormal();
    material.emissive = vec3(0.0);
    material.occlusion = 1.0;
    PrepareMaterial(material);
  }
}
